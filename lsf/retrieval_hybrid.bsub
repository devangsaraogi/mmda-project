#!/bin/bash
#BSUB -J clip-hybrid
#BSUB -o logs/retrieval_hybrid_%J.out
#BSUB -e logs/retrieval_hybrid_%J.err
#BSUB -W 1:00
#BSUB -q short_gpu
#BSUB -gpu "num=1:j_exclusive=yes"
#BSUB -n 8
#BSUB -M 16GB

echo "========================================"
echo "MMDA — Caption-Augmented Hybrid Retrieval"
echo "========================================"
echo "Job ID: $LSB_JOBID"
echo "Job Name: $LSB_JOBNAME"
echo "Queue: $LSB_QUEUE"
echo "Host: $HOSTNAME"
echo "Start time: $(date)"

# Load modules
echo -e "\n1. Loading modules..."
module load python/3.11 2>/dev/null || module load python/3.9.6 2>/dev/null || module load python 2>/dev/null
module load cuda/12.1 2>/dev/null || module load cuda/11.8 2>/dev/null || module load cuda 2>/dev/null
module list

# Activate virtual environment
echo -e "\n2. Activating virtual environment..."
if [ -f "$LS_SUBCWD/setup.py" ]; then
    PROJECT_ROOT="$LS_SUBCWD"
elif [ -f "$LS_SUBCWD/../setup.py" ]; then
    PROJECT_ROOT="$(cd "$LS_SUBCWD/.." && pwd)"
else
    echo "ERROR: could not locate project root (setup.py) from LS_SUBCWD=$LS_SUBCWD" >&2
    exit 2
fi
cd "$PROJECT_ROOT"
mkdir -p logs
source venv/bin/activate
echo "Python: $(python --version)"
echo "Working directory: $(pwd)"

# GPU info
echo -e "\n3. GPU info:"
python -c "import torch; print(f'PyTorch: {torch.__version__}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"
echo ""
nvidia-smi

# Redirect caches + offline HF
GROUP=$(groups | cut -d' ' -f1)
SCRATCH="/share/$GROUP/$USER"
export MPLCONFIGDIR="$SCRATCH/tmp/matplotlib"
export HF_HOME="$SCRATCH/.cache/huggingface"
export TORCH_HOME="$SCRATCH/.cache/torch"
export XDG_CACHE_HOME="$SCRATCH/.cache"
mkdir -p "$MPLCONFIGDIR" "$HF_HOME" "$TORCH_HOME"
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

DATASET=/share/csc791003s26/cmvn/dataset-folder
ADV_WITH_CANDS=$DATASET/step0_out/webqa_adv_with_candidates.jsonl

# Require the enriched JSONL. IMPORTANT: the latest enrichment also
# carries image_candidate_metadata (title + caption). If your copy
# predates that, delete it so the enrichment regenerates.
if [ ! -s "$ADV_WITH_CANDS" ]; then
    echo "ERROR: $ADV_WITH_CANDS missing. Run lsf/retrieval_per_claim.bsub first."
    exit 2
fi
if ! python -c "
import json, sys
with open('$ADV_WITH_CANDS') as f:
    for line in f:
        if line.strip():
            obj = json.loads(line)
            if 'image_candidate_metadata' not in obj:
                sys.exit(1)
            break
" 2>/dev/null; then
    echo "WARN: enriched JSONL lacks image_candidate_metadata — regenerating."
    python scripts/enrich_webqa_adv_candidates.py \
        --adv-in $DATASET/step0_out/webqa_adv.jsonl \
        --webqa $DATASET/extracted_webqa_data/WebQA_train_val.json \
        --out "$ADV_WITH_CANDS"
fi

EMBEDDINGS=$(ls -t results/runs/*/embeddings/image_index.pt 2>/dev/null | head -n 1)
if [ -z "$EMBEDDINGS" ]; then
    echo "ERROR: no CLIP image index found."
    exit 2
fi
echo "Using CLIP index: $EMBEDDINGS"

python scripts/run_retrieval_hybrid.py \
    --config configs/default.yaml \
    --embeddings "$EMBEDDINGS" \
    --k-rrf 60 \
    data.webqa_jsonl=$ADV_WITH_CANDS \
    data.webqa_images_tsv=$DATASET/images/imgs.tsv \
    data.webqa_images_lineidx=$DATASET/images/imgs.lineidx \
    clip.device=cuda

EXIT_CODE=$?

echo -e "\n========================================"
echo "Hybrid retrieval complete!"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================"

exit $EXIT_CODE
