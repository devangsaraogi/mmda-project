#!/bin/bash
#BSUB -J mm-pipe-pc
#BSUB -o logs/multimodal_pipeline_per_claim_%J.out
#BSUB -e logs/multimodal_pipeline_per_claim_%J.err
#BSUB -W 4:00
#BSUB -q gpu
#BSUB -gpu "num=1:j_exclusive=yes"
#BSUB -n 8
#BSUB -M 32GB

echo "========================================"
echo "MMDA — Multimodal Pipeline (PER-CLAIM visual retrieval)"
echo "========================================"
echo "Job ID: $LSB_JOBID"
echo "Job Name: $LSB_JOBNAME"
echo "Queue: $LSB_QUEUE"
echo "Host: $HOSTNAME"
echo "Start time: $(date)"

# Load modules
echo -e "\n1. Loading modules..."
module load python/3.11 2>/dev/null || module load python/3.9.6 2>/dev/null || module load python 2>/dev/null
module load cuda/12.1 2>/dev/null || module load cuda/11.8 2>/dev/null || module load cuda 2>/dev/null
module list

# Activate virtual environment
echo -e "\n2. Activating virtual environment..."
# Robust to submitting from either mmda-project/ or mmda-project/lsf/
if [ -f "$LS_SUBCWD/setup.py" ]; then
    PROJECT_ROOT="$LS_SUBCWD"
elif [ -f "$LS_SUBCWD/../setup.py" ]; then
    PROJECT_ROOT="$(cd "$LS_SUBCWD/.." && pwd)"
else
    echo "ERROR: could not locate project root (setup.py) from LS_SUBCWD=$LS_SUBCWD" >&2
    exit 2
fi
cd "$PROJECT_ROOT"
mkdir -p logs
source venv/bin/activate
echo "Python: $(python --version)"
echo "Working directory: $(pwd)"

# GPU info
echo -e "\n3. GPU info:"
python -c "import torch; print(f'PyTorch: {torch.__version__}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"
echo ""
nvidia-smi

# Redirect caches + offline mode (models are already cached)
GROUP=$(groups | cut -d' ' -f1)
SCRATCH="/share/$GROUP/$USER"
export MPLCONFIGDIR="$SCRATCH/tmp/matplotlib"
export HF_HOME="$SCRATCH/.cache/huggingface"
export TORCH_HOME="$SCRATCH/.cache/torch"
export XDG_CACHE_HOME="$SCRATCH/.cache"
mkdir -p "$MPLCONFIGDIR" "$HF_HOME" "$TORCH_HOME"
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

echo -e "\n========================================"
echo "Starting multimodal pipeline (per-claim visual retrieval)..."
echo "========================================"

DATASET=/share/csc791003s26/cmvn/dataset-folder
ADV_WITH_CANDS=$DATASET/step0_out/webqa_adv_with_candidates.jsonl

# Sanity check: the enriched JSONL must exist. If it doesn't, run
# lsf/retrieval_per_claim.bsub first (its enrichment step is idempotent).
if [ ! -s "$ADV_WITH_CANDS" ]; then
    echo "ERROR: $ADV_WITH_CANDS is missing or empty — submit retrieval_per_claim.bsub first to enrich."
    exit 2
fi

# Reuse the most recent pre-computed CLIP index.
EMBEDDINGS=$(ls -t results/runs/*/embeddings/image_index.pt 2>/dev/null | head -n 1)
if [ -z "$EMBEDDINGS" ]; then
    echo "ERROR: no pre-computed CLIP image index found under results/runs/*/embeddings/."
    exit 2
fi
echo "Using CLIP index: $EMBEDDINGS"

# Reuse the most recent NLI scores if present (skips the DeBERTa pass).
NLI_SCORES=$(ls -t results/runs/*/nli_scores.pt 2>/dev/null | head -n 1)
if [ -n "$NLI_SCORES" ]; then
    echo "Using NLI scores: $NLI_SCORES"
fi

python scripts/run_multimodal_pipeline.py \
    --config configs/default.yaml \
    --per-claim-retrieval \
    --embeddings "$EMBEDDINGS" \
    ${NLI_SCORES:+--nli-scores "$NLI_SCORES"} \
    data.webqa_jsonl=$ADV_WITH_CANDS \
    data.webqa_images_tsv=$DATASET/images/imgs.tsv \
    data.webqa_images_lineidx=$DATASET/images/imgs.lineidx \
    clip.device=cuda

EXIT_CODE=$?

echo -e "\n========================================"
echo "Multimodal pipeline (per-claim) complete!"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================"

LATEST_RUN=$(ls -td results/runs/*/ 2>/dev/null | head -1)
if [ -n "$LATEST_RUN" ]; then
    echo -e "\nRun directory: $LATEST_RUN"
fi

exit $EXIT_CODE
