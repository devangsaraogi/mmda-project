#!/bin/bash
#BSUB -J clip-verify
#BSUB -o logs/verification_%J.out
#BSUB -e logs/verification_%J.err
#BSUB -W 2:00
#BSUB -q short_gpu
#BSUB -gpu "num=1:j_exclusive=yes"
#BSUB -n 8
#BSUB -M 16GB

echo "========================================"
echo "MMDA — Verification Evaluation"
echo "========================================"
echo "Job ID: $LSB_JOBID"
echo "Job Name: $LSB_JOBNAME"
echo "Queue: $LSB_QUEUE"
echo "Host: $HOSTNAME"
echo "Start time: $(date)"

# Load modules
echo -e "\n1. Loading modules..."
module load python/3.11 2>/dev/null || module load python/3.9.6 2>/dev/null || module load python 2>/dev/null
module load cuda/12.1 2>/dev/null || module load cuda/11.8 2>/dev/null || module load cuda 2>/dev/null
module list

# Activate virtual environment
echo -e "\n2. Activating virtual environment..."
# Robust to submitting from either mmda-project/ or mmda-project/lsf/
if [ -f "$LS_SUBCWD/setup.py" ]; then
    PROJECT_ROOT="$LS_SUBCWD"
elif [ -f "$LS_SUBCWD/../setup.py" ]; then
    PROJECT_ROOT="$(cd "$LS_SUBCWD/.." && pwd)"
else
    echo "ERROR: could not locate project root (setup.py) from LS_SUBCWD=$LS_SUBCWD" >&2
    exit 2
fi
cd "$PROJECT_ROOT"
mkdir -p logs
source venv/bin/activate
echo "Python: $(python --version)"
echo "Working directory: $(pwd)"

# GPU info
echo -e "\n3. GPU info:"
python -c "import torch; print(f'PyTorch: {torch.__version__}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"
echo ""
nvidia-smi

# Redirect caches to scratch to avoid home quota issues
GROUP=$(groups | cut -d' ' -f1)
SCRATCH="/share/$GROUP/$USER"
export MPLCONFIGDIR="$SCRATCH/tmp/matplotlib"
export HF_HOME="$SCRATCH/.cache/huggingface"
export TORCH_HOME="$SCRATCH/.cache/torch"
export XDG_CACHE_HOME="$SCRATCH/.cache"
mkdir -p "$MPLCONFIGDIR" "$HF_HOME" "$TORCH_HOME"
export PYTHONUNBUFFERED=1

# Compute nodes have no internet — CLIP + DeBERTa are already in $HF_HOME/hub
# (verified 2026-04-18). Skip the 4-minute Hub ping timeout loop.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# Run
echo -e "\n========================================"
echo "Starting verification evaluation..."
echo "========================================"

DATASET=/share/csc791003s26/cmvn/dataset-folder

# Resolve artifacts from the most recent runs (not a hardcoded path, which
# silently breaks the moment directory layouts shift). The fallbacks exist
# because prior code sometimes wrote image_index.pt under results/embeddings/
# and sometimes under results/runs/<GPU>_<TS>/embeddings/.
EMBEDDINGS=$(ls -t results/runs/*/embeddings/image_index.pt 2>/dev/null | head -n 1)
if [ -z "$EMBEDDINGS" ]; then
    EMBEDDINGS=$(ls -t results/embeddings/image_index*.pt 2>/dev/null | head -n 1)
fi
if [ -z "$EMBEDDINGS" ] || [ ! -s "$EMBEDDINGS" ]; then
    echo "ERROR: no pre-computed CLIP embedding index found. E2E verification cannot proceed." >&2
    echo "Searched: results/runs/*/embeddings/image_index.pt and results/embeddings/image_index*.pt" >&2
    exit 2
fi
echo "Using CLIP index: $EMBEDDINGS"

CHECKPOINT=$(ls -t results/runs/*/checkpoints/mlp_best.pt 2>/dev/null | head -n 1)
if [ -z "$CHECKPOINT" ]; then
    CHECKPOINT=results/checkpoints/mlp_best.pt
fi
if [ ! -s "$CHECKPOINT" ]; then
    echo "ERROR: no trained MLP checkpoint found at $CHECKPOINT" >&2
    echo "Searched: results/runs/*/checkpoints/mlp_best.pt and results/checkpoints/mlp_best.pt" >&2
    exit 2
fi
echo "Using MLP checkpoint: $CHECKPOINT"

python scripts/run_verification.py \
    --config configs/default.yaml \
    --embeddings "$EMBEDDINGS" \
    --checkpoint "$CHECKPOINT" \
    data.webqa_jsonl=$DATASET/step0_out/webqa_adv.jsonl \
    data.webqa_images_tsv=$DATASET/images/imgs.tsv \
    data.webqa_images_lineidx=$DATASET/images/imgs.lineidx \
    clip.device=cuda

EXIT_CODE=$?

echo -e "\n========================================"
echo "Job complete!"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================"

exit $EXIT_CODE
