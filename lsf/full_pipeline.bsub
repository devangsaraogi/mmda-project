#!/bin/bash
#BSUB -J clip-full
#BSUB -o ../logs/full_pipeline_%J.out
#BSUB -e ../logs/full_pipeline_%J.err
#BSUB -W 4:00
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -n 8
#BSUB -M 32GB

echo "========================================"
echo "MMDA — Full Pipeline (End-to-End)"
echo "========================================"
echo "Job ID: $LSB_JOBID"
echo "Job Name: $LSB_JOBNAME"
echo "Queue: $LSB_QUEUE"
echo "Host: $HOSTNAME"
echo "Start time: $(date)"

# Load modules
echo -e "\n1. Loading modules..."
module load python/3.11 2>/dev/null || module load python/3.9.6 2>/dev/null || module load python 2>/dev/null
module load cuda/12.1 2>/dev/null || module load cuda/11.8 2>/dev/null || module load cuda 2>/dev/null
module list

# Activate virtual environment
echo -e "\n2. Activating virtual environment..."
cd $LS_SUBCWD/..
source venv/bin/activate
echo "Python: $(python --version)"
echo "Working directory: $(pwd)"

# GPU info
echo -e "\n3. GPU info:"
python -c "import torch; print(f'PyTorch: {torch.__version__}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"
echo ""
nvidia-smi

# Storage info
GROUP=$(groups | cut -d' ' -f1)
echo -e "\n4. Storage info:"
echo "Current location: $(pwd)"
echo "Available space:"
df -h . | tail -1

# Redirect caches to scratch to avoid home quota issues
SCRATCH="/share/$GROUP/$USER"
export MPLCONFIGDIR="$SCRATCH/tmp/matplotlib"
export HF_HOME="$SCRATCH/.cache/huggingface"
export TORCH_HOME="$SCRATCH/.cache/torch"
export XDG_CACHE_HOME="$SCRATCH/.cache"
mkdir -p "$MPLCONFIGDIR" "$HF_HOME" "$TORCH_HOME"
export PYTHONUNBUFFERED=1

# Run
echo -e "\n========================================"
echo "Starting full pipeline..."
echo "========================================"

DATASET=/share/csc791003s26/cmvn/dataset-folder

# Set this to skip embedding computation and reuse a previous run's embeddings, e.g.:
# EMBEDDINGS=results/runs/NVIDIA_H200_NVL_20260301_170346/embeddings/image_index.pt
EMBEDDINGS=""

python scripts/run_full_pipeline.py \
    --config configs/default.yaml \
    ${EMBEDDINGS:+--embeddings "$EMBEDDINGS"} \
    data.webqa_jsonl=$DATASET/step0_out/webqa_adv.jsonl \
    data.webqa_images_tsv=$DATASET/images/imgs.tsv \
    data.webqa_images_lineidx=$DATASET/images/imgs.lineidx \
    clip.device=cuda

EXIT_CODE=$?

echo -e "\n========================================"
echo "Pipeline complete!"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================"

# Show generated files (find the most recent run directory)
LATEST_RUN=$(ls -td results/runs/*/ 2>/dev/null | head -1)
if [ -n "$LATEST_RUN" ]; then
    echo -e "\nRun directory: $LATEST_RUN"
    echo "Generated files:"
    find "$LATEST_RUN" -type f | sort
fi

exit $EXIT_CODE
